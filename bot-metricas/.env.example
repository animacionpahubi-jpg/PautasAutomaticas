# Copia este archivo como .env (en esta misma carpeta) y llena los valores.
# El .env NUNCA se sube a GitHub ni se pega en chats. Dónde sacar cada llave: TRASPASO.md, sección 4.

# Telegram: @BotFather -> /mybots -> @metricas_pahubi_bot -> API Token
TELEGRAM_TOKEN=

# IDs de Telegram de las personas que pueden usar el bot, separados por coma
ALLOWED_CHAT_IDS=
# Quiénes pueden aprobar pautas de Pahubi (si queda vacío, cualquiera de ALLOWED_CHAT_IDS)
PAHUBI_APROBADORES=

# Windsor.ai: windsor.ai -> cuenta -> API key (lee Meta, Instagram, TikTok, GA4 y ejecuta acciones)
WINDSOR_API_KEY=

# Claude por API (opcional). Si está vacío, el bot usa Claude Code instalado en el PC.
ANTHROPIC_API_KEY=

# WooCommerce: pahubi.com -> WooCommerce -> Ajustes -> Avanzado -> API REST -> clave de SOLO LECTURA
WOO_URL=https://pahubi.com
WOO_KEY=
WOO_SECRET=

# Cuentas de Meta (no cambiar: son las correctas)
META_CUENTA_PAHUBI=2071312623652434
META_CUENTA_EVA=1805850660019527
HORA_RESUMEN_DIARIO=8

# Mercado Libre (app "Pahubi Metricas", solo lectura). Se llenan con mercadolibre_token.py
ML_APP_ID=
ML_SECRET=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_USER_ID=

# TikTok Marketing API (app "Pahubi Metricas Bot", ID 7706642148078125077, aprobada 10 nov 2026)
# APP_ID y SECRET: business-api.tiktok.com/portal -> My Apps. ACCESS_TOKEN: con tiktok_token.py
TIKTOK_APP_ID=7706642148078125077
TIKTOK_SECRET=
TIKTOK_ACCESS_TOKEN=
